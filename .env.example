# Optional. The desk runs on public Yahoo Finance charts and public RSS when these are unset.
# Do not commit real values. Copy this file to .env for local runs.
# On Cursor hosting, set the same names with `agent-sdk secret set` (stdin, not argv).

# Stock quote fallback when Yahoo fails. https://finnhub.io
FINNHUB_API_KEY=

# Stock history fallback when Yahoo fails. https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=

# Optional CoinGecko demo key for the BTC, SOL, and HYPE fallback.
# The public market_chart endpoint works with this unset. https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Optional business-headline supplement. https://newsapi.org
NEWSAPI_KEY=
